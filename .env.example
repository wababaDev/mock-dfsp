# Auth token every request must send as: Authorization: Bearer <token>
AUTH_TOKEN=1000000000

# MODE controls the /simulate/* endpoints only:
#   test — never calls the core connector, returns canned responses
#   live — really calls the connector at CORE_CONNECTOR_URL
MODE=test

# Where the core connector's DFSP-facing server (port 3004) is reachable.
# If the connector is running in Docker and this mock is not (or vice versa),
# this will need to be host.docker.internal instead of localhost.
CORE_CONNECTOR_URL=http://localhost:3004

SEED_FILE=seeds/bluebank.json